# Postgres (Homebrew default: local socket, current OS user)
DATABASE_URL=postgres://localhost:5432/careerpilot
TEST_DATABASE_URL=postgres://localhost:5432/careerpilot_test

# AI layer: optional. Without any of these, CareerPilot uses its free rule-based features.
# Option A, Claude (paid, best quality):
ANTHROPIC_API_KEY=
CLAUDE_REASONING_MODEL=claude-opus-5-5
CLAUDE_EXTRACTION_MODEL=claude-haiku-5-5
# Option B, free: any OpenAI-compatible API. Used only when ANTHROPIC_API_KEY is empty.
#   Gemini free tier (key: https://aistudio.google.com/apikey). Note: free-tier content may be used by Google to improve its products.
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_API_KEY=your-gemini-key
#     LLM_MODEL=gemini-3.5-flash-lite            (fast, ~3-4 s, and enough quality for this app)
#     LLM_EXTRACTION_MODEL=gemini-3.5-flash-lite
#     LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash   (used on quota/busy/slow)
#     LLM_TIMEOUT_MS=45000        (per call; keep the 180000 default for local Ollama)
#     LLM_TOTAL_BUDGET_MS=90000   (per AI step across fallbacks; then the free rules take over)
#   Ollama, fully local and private (brew install ollama && ollama pull qwen2.5:3b):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EXTRACTION_MODEL=
LLM_FALLBACK_MODELS=

# Local embeddings (bge-small, downloaded on first use, ~35MB). Set to "off" to use lexical similarity only.
EMBEDDINGS=local

# Job sources (optional). Free keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional, raises GitHub API rate limits for the GitHub import
GITHUB_TOKEN=

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
